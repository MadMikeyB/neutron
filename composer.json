{
    "name": "madmikeyb/neutron",
    "description": "Neutron PHP Framework",
    "type": "project",
    "minimum-stability": "dev",
    "license": "BSD-2-Clause",
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "symfony/var-dumper": "^8.0",
        "filp/whoops": "^2.18",
        "monolog/monolog": "^3",
        "twig/twig": "^4.0",
        "league/route": "^6",
        "league/container": "^5",
        "league/event": "^3.0",
        "laminas/laminas-diactoros": "^3",
        "laminas/laminas-httphandlerrunner": "^2.1",
        "symfony/console": "^8.0"
    },
    "config": {
        "platform": {
            "php": "8.4"
        }
    },
    "autoload": {
        "psr-4": {
            "Neutron\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "scripts": {
        "post-create-project-cmd": [
            "Neutron\\Installer::postCreateProject"
        ]
    }
}